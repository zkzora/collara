# Collara environment template. Synthetic demo data only; every value here is for local development.
#
# Copy to `.env` at the repo root, or run `node scripts/dev/init-env.mjs`, which copies this file and
# fills the empty secrets below with random dev-only values. apps/api and apps/worker load `.env` with
# `--env-file-if-exists=../../.env`, and so do scripts/infra/*.mjs and scripts/dev/*.mjs. Variables
# already set in the shell win; empty values count as unset.
# The web app does not read this file: copy infra/env/web.env.example to apps/web/.env.local.
# Never put real credentials in a committed file.

# --- Mode and demo switches ------------------------------------------------------------------
# Runtime mode: UI_MOCK (default; needs no API, database or ledger) or LOCALNET.
COLLARA_MODE=UI_MOCK
# Isolated demo persona sessions (POST /api/demo/sessions). Local demos only, never a production login.
DEMO_SESSIONS_ENABLED=false
# With NODE_ENV=production the API refuses demo sessions unless this is set (hosted synthetic demo only).
# DEMO_SESSIONS_ALLOW_IN_PRODUCTION=false

# --- apps/api --------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Trust X-Forwarded-For only from these proxies (unset = trust none). Next.js alone does not sanitize it.
# TRUST_PROXY=127.0.0.1,::1
# Browser-facing origin (the Next app): OIDC redirect default, post-logout target, CSRF origin check.
PUBLIC_ORIGIN=http://localhost:3000
# Extra origins allowed to send cookie-authenticated mutations (comma-separated, exact match).
# CSRF_TRUSTED_ORIGINS=
# Signs the session cookie: at least 32 random characters (init-env.mjs generates one).
SESSION_SECRET=
# SESSION_TTL_SECONDS=28800
# true = Secure cookie named __Host-collara_sid (HTTPS only; also needs TRUST_PROXY behind a proxy).
COOKIE_SECURE=false
# POST /api/pilot-requests limit per client IP (behind the Next proxy alone, all clients share one bucket).
# PILOT_RATE_LIMIT_MAX=5
# PILOT_RATE_LIMIT_WINDOW_MS=600000

# --- PostgreSQL 16 (Windows dev: WSL Ubuntu, `node scripts/dev/wsl-postgres.mjs up`) ----------
# Unset = no database (fine for UI_MOCK). Dev-only role on a loopback database with synthetic data.
# DATABASE_URL=postgres://collara:collara_dev@127.0.0.1:5432/collara
# Integration tests against real PostgreSQL (unit tests use PGlite and need nothing).
# TEST_DATABASE_URL=postgres://collara:collara_dev@127.0.0.1:5432/collara_test

# --- OIDC login (dev: Keycloak 26.7.5, `node scripts/infra/keycloak.mjs start`) ----------------
# Realm: infra/keycloak/collara-realm.json. Plain HTTP is acceptable for this local issuer only.
COLLARA_OIDC_ISSUER=http://localhost:18080/realms/collara
COLLARA_OIDC_CLIENT_ID=collara-web
# Also written into the realm when Keycloak first imports it; after changing it run `keycloak.mjs reset`.
COLLARA_OIDC_CLIENT_SECRET=
COLLARA_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# COLLARA_OIDC_SCOPES=openid email profile
# Needed for the http:// issuer above; the API honours it only when NODE_ENV=development.
COLLARA_OIDC_ALLOW_INSECURE_HTTP=true
# The post-logout redirect is PUBLIC_ORIGIN + "/" (registered in the realm as http://localhost:3000/).
# Keycloak bootstrap admin, used by scripts/infra/keycloak.mjs and compose only (never by the apps).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# --- Evidence storage (dev: SeaweedFS 4.48, `node scripts/infra/seaweedfs.mjs start`) -----------
# Private bucket, path-style addressing. Locally this key pair is also SeaweedFS's admin identity.
COLLARA_S3_ENDPOINT=http://127.0.0.1:8333
COLLARA_S3_REGION=us-east-1
COLLARA_S3_BUCKET=collara-evidence
COLLARA_S3_ACCESS_KEY=collara-dev
COLLARA_S3_SECRET_KEY=
# Host used in presigned download URLs when browsers reach storage under another name than the API.
# COLLARA_S3_PUBLIC_ENDPOINT=

# --- Canton ledger (LOCALNET: `node scripts/localnet/up.mjs --bootstrap`) ---------------------
# Not read by the API or worker yet: the API's ledger health probe uses the participant URLs in
# .local/localnet/state.json (see COLLARA_LOCALNET_STATE below).
CANTON_JSON_API_URL=http://127.0.0.1:7575
# HS256 secret and token audience of the sandbox's unsafe-jwt-hmac-256 auth. Unset = the public dev
# placeholders in infra/canton/sandbox-auth.conf. scripts/localnet does not read .env: if you set them,
# export them in the shell that starts the sandbox as well.
# CANTON_JWT_HMAC_SECRET=
# CANTON_JWT_AUDIENCE=https://collara.local/ledger-api
# Ledger users and party ids are not configured here. scripts/localnet/bootstrap.mjs writes them to
# .local/localnet/state.json (party ids change on every sandbox start). Users: registrar-svc,
# governance-svc, borrower-svc, dealer-svc, verifier-svc, lender-a-svc, lender-b-svc, auditor-svc,
# gov-seat-1-svc, gov-seat-2-svc, gov-seat-3-svc; the worker reads with projector-svc.
# Absolute path override for that file (default <repo>/.local/localnet/state.json):
# COLLARA_LOCALNET_STATE=

# --- apps/worker (also reads COLLARA_MODE, LOG_LEVEL, DATABASE_URL, COLLARA_LOCALNET_STATE and the Canton settings) ---
# LOCALNET: projects /v2/updates per source, advances command states, reconciles unknown outcomes, runs export jobs.
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4100
# WORKER_PORT overrides WORKER_HEALTH_PORT when both are set.
# PROJECTION_POLL_INTERVAL_MS=1000
# PROJECTION_DELAY_SECONDS=5
# Read by the API's /api/system/health: a projection checkpoint older than this is reported degraded.
# WORKER_STALE_AFTER_SECONDS=120

# --- apps/web: not read from this file (see infra/env/web.env.example) ------------------------
# API_INTERNAL_ORIGIN=http://127.0.0.1:4000
# off (default) | ui_mock (public UI mockup demo; only with COLLARA_MODE=UI_MOCK) | localnet (only with COLLARA_MODE=LOCALNET)
# PUBLIC_DEMO_STATUS=off
# NEXT_DIST_DIR=.next
