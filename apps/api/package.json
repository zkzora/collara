{
  "name": "@collara/api",
  "version": "0.0.0",
  "private": true,
  "description": "Collara API (Fastify 5): auth/session, permission and mandate checks, domain services, Canton commands, evidence storage, OpenAPI",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/db.ts migrate",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/db.ts seed",
    "db:bind-localnet": "tsx --env-file-if-exists=../../.env scripts/db.ts bind-localnet",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@collara/canton": "workspace:*",
    "@collara/db": "workspace:*",
    "@collara/domain": "workspace:*",
    "@fastify/cookie": "catalog:",
    "@fastify/csrf-protection": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/multipart": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@fastify/session": "catalog:",
    "@fastify/swagger": "catalog:",
    "@fastify/swagger-ui": "catalog:",
    "decimal.js": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "jose": "catalog:",
    "openapi-types": "catalog:",
    "openid-client": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "openapi-typescript": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
