-- | Reusable Daml Script building blocks for the Collara synthetic demo. Every step goes through the real
-- choices with the same single submitter the API uses, so the tests, the seed scripts and the API integration
-- exercise one command sequence. Times are relative to ledger time; nothing is hard-coded to a calendar date.
module Collara.Scripts.Scenario where

import DA.Date (toDateUTC)
import DA.Optional (fromSomeNote)
import qualified DA.Set as Set
import DA.Time (RelTime, addRelTime, days, minutes)
import Daml.Script

import Governance.Action (GovernableAction)
import Governance.Confirmation (GovernanceConfirmation)
import Governance.ExecutionResult (GovernanceExecutionResult)
import Governance.Rules

import Collara.Audit hiding (AuditPermission(..))
import qualified Collara.Audit as Audit
import Collara.Config
import Collara.Control
import Collara.Evidence
import Collara.Financing hiding (AssessmentStatus(..))
import qualified Collara.Financing as Fin
import Collara.Governance.Proposals
import Collara.Governance.Registry
import Collara.Registration
import Collara.Release hiding (ReleaseOutcome(..), ReleaseStatus(..))
import qualified Collara.Release as Rel
import Collara.Types
import Collara.Verification hiding (VerificationStatus(..))

-- * Synthetic fixture constants (docs/_research/synthesis.md §1.6)

