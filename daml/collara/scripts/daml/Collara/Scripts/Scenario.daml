hashInvoiceV1 = "8d24047a96ad595116211206cf8ec06acabd464e732bf32c7551632a69e9aab0"
hashPhotosV1 = "8bfab457ba9f13a6d52a000baf10a0548ab018f15fc4df66f85d10355856eb25"
hashInspectionV1 = "efe58c5d9bd84bfe24a0e176c8831a3d221689628a5b64dd699b5dfa314d70e3"
hashInspectionV2 = "76e83a1b46f73b87cd4791aaf9166fceef817b038fa037c11309e9b9cdaf2f5e"
hashMaintenanceV1 = "101a1bea0283609fe372fd1ef681e56360fa875e4d659a50db76c5bceee69c18"
hashMaintenanceV2 = "d86c4274921a88ab0fddebe55c8593191b5eb18f538566cbf2e92baf5780ef3c"

hashManifestV1, hashManifestV2, hashManifestV3 : Text
hashManifestV1 = "ec6ddb981bb9ea659644f49e9ccd6dded0430c5d999ccef81470c04d941a027c"
hashManifestV2 = "b3cc20c09b9351787c51d6f7c5288a077684f4fd27649fdba3a666162cbe0097"
