-- | Only an active, assigned verifier holding an accreditation from the pinned governance party can attest
-- (S 11.7 #7); suspension blocks new attestations and, by policy, new activations.
module Collara.Tests.Verification where

import DA.Time (addRelTime, days)
import Daml.Script

import Collara.Config
import Collara.Evidence
import Collara.Governance.Registry
import Collara.Scripts.Scenario
import Collara.Scripts.Seed
import Collara.Tests.Common
import Collara.Tests.Util
import Collara.Types (EvidenceAnchor(..))
import Collara.Verification hiding (VerificationStatus(..))

-- | The owner asks `verifier` to verify the manifest (a new request `requestRef`).
requestFrom : Ledger -> ContractId EvidenceManifest -> Party -> Text -> Script (ContractId VerificationRequest)
requestFrom l manifestCid verifier requestRef = submit l.parties.owner $ exerciseCmd manifestCid Manifest_RequestVerification with
  verifier
  requestRef
  passportVersion = 1
  caseRef = Some fixtureCaseRef
  equipmentScope = cncScope
  checklist = ["Serial number consistency"]
  dueBy = None
  actorRef = ownerActor

-- | Adds `verifier` to the registrar's directory, so it can read the config (a registrar step after AddVerifier).
withDirectoryMember : Ledger -> Party -> Script Ledger
withDirectoryMember l verifier = do
  let p = l.parties
  configCid <- submit p.registrar $ exerciseCmd l.configCid Config_Update with
    newGovernanceParty = p.governance
    newSuspensionPolicy = REQUIRE_ACTIVE_VERIFIER
    newDirectory = [p.verifier, verifier, p.lenderA, p.lenderB]
  pure l with configCid

test_unassigned_verifier_cannot_attest : Script ()
test_unassigned_verifier_cannot_attest = do
  (l0, _, requestCid) <- seedCleanStart >>= requestInReview
  let p = l0.parties
  verifier2 <- allocatePartyByHint (PartyIdHint "T02")
  acc2 <- addVerifierGoverned l0 verifier2 "VER-T02" (days 365) [cncScope]
  l <- withDirectoryMember l0 verifier2
  now <- getTime
  let issue = issueAttestationCmd l.configCid requestCid "ATT-X" now (days 30) acc2
  rHidden <- trySubmit verifier2 issue
  expectNotVisible rHidden
  rWithRead <- trySubmit (actAs verifier2 <> readAs p.owner) issue
  expectAuthorizationFailure rWithRead
  assertActive "request still open" p.owner requestCid

-- | After a governed suspension, the verifier's old accreditation id is archived and the new one is SUSPENDED:
-- neither lets it accept an assignment or issue an attestation.
test_suspended_verifier_cannot_attest : Script ()
test_suspended_verifier_cannot_attest = do
  (l, manifestCid, requestCid) <- seedCleanStart >>= requestInReview
  let p = l.parties
  suspendedCid <- suspendVerifierGoverned l p.verifier
  now <- getTime
  rOld <- trySubmit p.verifier $ issueAttestationCmd l.configCid requestCid "ATT-001" now (days 30) l.accreditationCid
  expectConsumed rOld
  rNew <- trySubmit p.verifier $ issueAttestationCmd l.configCid requestCid "ATT-001" now (days 30) suspendedCid
  expectFailure "Verifier suspended" rNew
  request2 <- requestFrom l manifestCid p.verifier "VR-002"
  rAccept <- trySubmit p.verifier $ exerciseCmd request2 VR_AcceptAssignment with
    configCid = l.configCid; accreditationCid = suspendedCid; actorRef = verifierActor
  expectFailure "Verifier suspended" rAccept
  attestations <- query @VerificationAttestation p.owner
  assertEq "no attestation issued" 0 (length attestations)

-- | A suspended verifier tries to bypass suspension with an accreditation signed by a rogue governance party, and
-- then with a rogue registrar's config that pins the rogue governance party.
test_forged_accreditation_rejected : Script ()
test_forged_accreditation_rejected = do
  (l, _, requestCid) <- seedCleanStart >>= requestInReview
  let p = l.parties
  _ <- suspendVerifierGoverned l p.verifier
  rogueGov <- allocatePartyByHint (PartyIdHint "RogueGovernance")
  rogueRegistrar <- allocatePartyByHint (PartyIdHint "RogueRegistrar")
  forged <- submit rogueGov $ createCmd VerifierAccreditation with
    governanceParty = rogueGov
    operator = p.registrar
    verifier = p.verifier
    verifierRef = "VER-001"
    orgName = "Demo Verifier"
    scope = [cncScope]
    status = ACTIVE
    validUntil = None
    registryId = fixtureNamespace
    registryVersion = 0
    reason = "forged"
  now <- getTime
  rForged <- trySubmit p.verifier $ issueAttestationCmd l.configCid requestCid "ATT-001" now (days 30) forged
  expectFailure "Untrusted registry" rForged
  rogueConfig <- submit rogueRegistrar $ createCmd CollaraConfig with
    registrar = rogueRegistrar
    namespace = fixtureNamespace
    governanceParty = rogueGov
    suspensionPolicy = ALLOW_ISSUED_ATTESTATIONS
    configVersion = 1
    directory = [p.verifier]
  rRogueConfig <- trySubmit p.verifier $ issueAttestationCmd rogueConfig requestCid "ATT-001" now (days 30) forged
  expectFailure "Config of another registrar or namespace" rRogueConfig

test_expired_accreditation_rejected : Script ()
test_expired_accreditation_rejected = do
  (l0, manifestCid, _) <- seedCleanStart >>= requestInReview
  let p = l0.parties
  verifier2 <- allocatePartyByHint (PartyIdHint "T02")
  acc2 <- addVerifierGoverned l0 verifier2 "VER-T02" (days 1) [cncScope]
  l <- withDirectoryMember l0 verifier2
  request <- requestFrom l manifestCid verifier2 "VR-002"
  accepted <- submit verifier2 $ exerciseCmd request VR_AcceptAssignment with
    configCid = l.configCid; accreditationCid = acc2; actorRef = "mbr:verifier-2"
  passTime (days 2)
  now <- getTime
  r <- trySubmit verifier2 $ issueAttestationCmd l.configCid accepted "ATT-002" now (days 30) acc2
  expectFailure "Accreditation expired" r

test_out_of_scope_verifier_rejected : Script ()
test_out_of_scope_verifier_rejected = do
  (l0, manifestCid, _) <- seedCleanStart >>= requestInReview
  verifier2 <- allocatePartyByHint (PartyIdHint "T02")
  acc2 <- addVerifierGoverned l0 verifier2 "VER-T02" (days 365) ["SYNTHETIC_OTHER_SCOPE"]
  l <- withDirectoryMember l0 verifier2
  request <- requestFrom l manifestCid verifier2 "VR-002"
  r <- trySubmit verifier2 $ exerciseCmd request VR_AcceptAssignment with
    configCid = l.configCid; accreditationCid = acc2; actorRef = "mbr:verifier-2"
  expectFailure "Out of accreditation scope" r

test_owner_cannot_forge_attestation : Script ()
test_owner_cannot_forge_attestation = do
  f <- seedMain
  let p = f.ledger.parties
  attestation <- fetchAs p.owner f.attestationCid
  rAttestation <- trySubmit p.owner $ createCmd attestation with attestationRef = "ATT-FORGED"
  expectAuthorizationFailure rAttestation
  disclosure <- fetchAs p.owner f.disclosureCid
  rDisclosure <- trySubmit p.owner $ createCmd disclosure with recipient = p.lenderB
  expectAuthorizationFailure rDisclosure

test_attestation_requires_open_review : Script ()
test_attestation_requires_open_review = do
  (l, _, requestCid) <- seedCleanStart >>= requestInReview
  let p = l.parties
  changes <- submit p.verifier $ exerciseCmd requestCid VR_RequestChanges with note = "more"; actorRef = verifierActor
  now <- getTime
  r <- trySubmit p.verifier $ issueAttestationCmd l.configCid changes "ATT-001" now (days 30) l.accreditationCid
  expectFailure "Request is not in review" r
  rOldEvidence <- trySubmit p.owner $ exerciseCmd changes VR_SubmitNewEvidence with
    newEvidence = EvidenceAnchor fixturePackageRef 1 hashManifestV1; actorRef = ownerActor
  expectFailure "Evidence must be a newer version of the same package" rOldEvidence

-- | A correction supersedes (consumes) the old attestation and withdraws its disclosures; revocation leaves a
-- record. Issued records are never edited.
test_supersede_and_revoke : Script ()
test_supersede_and_revoke = do
  (l, manifestCid, requestCid) <- seedCleanStart >>= requestInReview
  let p = l.parties
  att1 <- issueAttestation l requestCid "ATT-001" (days 30) l.accreditationCid
  disclosure1 <- submit p.owner $ exerciseCmd att1 Att_DiscloseTo with
    recipient = p.lenderA; purpose = "LENDER_REVIEW"; disclosureCaseRef = fixtureCaseRef; actorRef = ownerActor
  validity1 <- validityOf p.owner disclosure1
  request2 <- requestFrom l manifestCid p.verifier "VR-002"
  accepted2 <- acceptAssignment l request2
  now <- getTime
  att2 <- submit p.verifier $ exerciseCmd accepted2 VR_IssueAttestation with
    configCid = l.configCid
    accreditationCid = l.accreditationCid
    attestationRef = "ATT-002"
    checks = fixtureChecks
    limitations = "Correction of ATT-001."
    method = "Document review (synthetic)"
    inspectedAt = now
    validFrom = now
    validUntil = addRelTime now (days 30)
    supersedes = Some Supersession with previousCid = att1; previousDisclosureCids = [disclosure1]
    actorRef = verifierActor
  assertArchived "superseded ATT-001" p.owner att1
  assertArchived "disclosure of ATT-001" p.lenderA disclosure1
  assertArchived "validity marker of the ATT-001 disclosure" p.owner validity1
  corrected <- fetchAs p.owner att2
  assertEq "supersedes" (Some "ATT-001") corrected.supersedesRef
  revokedCid <- submit p.verifier $ exerciseCmd att2 Att_Revoke with
    reason = "Synthetic revocation"; disclosureCids = []; actorRef = verifierActor
  revoked <- fetchAs p.owner revokedCid
  assertEq "revocation record" "ATT-002" revoked.attestationRef
  assertArchived "revoked ATT-002" p.owner att2

-- | Default policy REQUIRE_ACTIVE_VERIFIER: once the registrar syncs the mirror to the suspended accreditation, a
-- new activation relying on that verifier's attestation fails. Under ALLOW_ISSUED_ATTESTATIONS it proceeds.
test_suspension_blocks_new_activation_by_policy : Script ()
test_suspension_blocks_new_activation_by_policy = do
  f <- seedMain
  let l = f.ledger
      p = l.parties
  fin <- financeToAuthorization f
  suspendedCid <- suspendVerifierGoverned l p.verifier
  rStaleSync <- trySubmit p.registrar $ exerciseCmd l.mirrorCid Mirror_Sync with
    configCid = l.configCid; accreditationCid = l.accreditationCid; newSourceRef = "GP-002"
  expectConsumed rStaleSync
  mirrorCid <- submit p.registrar $ exerciseCmd l.mirrorCid Mirror_Sync with
    configCid = l.configCid; accreditationCid = suspendedCid; newSourceRef = "GP-002"
  let synced = l with mirrorCid
  rOldMirror <- trySubmit p.lenderA $ activateCmd l p.lenderA f.controlCid fin.authorizationCid f.validityCid "PL-001"
  expectConsumed rOldMirror
  rSuspended <- trySubmit p.lenderA $ activateCmd synced p.lenderA f.controlCid fin.authorizationCid f.validityCid "PL-001"
  expectFailure "Verifier suspended" rSuspended
  configCid <- submit p.registrar $ exerciseCmd l.configCid Config_Update with
    newGovernanceParty = p.governance
    newSuspensionPolicy = ALLOW_ISSUED_ATTESTATIONS
    newDirectory = [p.verifier, p.lenderA, p.lenderB]
  _ <- activate (synced with configCid) p.lenderA f.controlCid fin.authorizationCid f.validityCid "PL-001"
  pure ()
