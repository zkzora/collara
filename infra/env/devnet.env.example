# DEVNET environment (HackCanton shared DevNet participant hosted by NODERS). Copy to <repo>/.env.devnet
# (git-ignored; never commit it). scripts/devnet/*.mjs read ONLY this file (not .env), so LocalNet settings are
# never picked up. Run the API and worker with the same values (e.g. node --env-file=.env.devnet ...).
# NO SECRETS GO HERE: the refresh token lives only in the DEVNET database (table ledger_credentials), written by
# `node scripts/devnet/login.mjs`, which asks for the team login on the terminal. Synthetic demo data only.

COLLARA_MODE=DEVNET

# A dedicated PostgreSQL database whose name contains "devnet". DEVNET refuses the LocalNet demo database
# (collara) and the test database (collara_test). Local WSL PostgreSQL example (the password is the local dev one):
DATABASE_URL=postgres://collara:collara_dev@127.0.0.1:5432/collara_devnet

# The tenant's ledger user id (the JWT `sub`). login.mjs prints it; paste it here after the first login.
DEVNET_LEDGER_USER_ID=

# HackCanton tenant endpoints (organisers' NODERS guide). These are the defaults; change only if NODERS says so.
CANTON_DEVNET_JSON_API_URL=https://ledger-api-json.participant.hackcanton-01.devnet.naas.noders.services
DEVNET_OIDC_ISSUER=https://keycloak.naas.noders.services/realms/noders-appsfactory
# DEVNET_OIDC_TOKEN_ENDPOINT=https://keycloak.naas.noders.services/realms/noders-appsfactory/protocol/openid-connect/token
# DEVNET_OIDC_JWKS_URI=https://keycloak.naas.noders.services/realms/noders-appsfactory/protocol/openid-connect/certs
DEVNET_OIDC_CLIENT_ID=web-app-ui-hackcanton-01-devnet
DEVNET_OIDC_SCOPE=openid daml_ledger_api offline_access
# Every access token's `aud` must contain this value.
DEVNET_LEDGER_AUDIENCE=https://hackcanton-01.devnet.naas.noders.services

# DevNet bindings written by scripts/devnet/import-bindings.mjs (default <repo>/.local/devnet/state.json).
# Never point this at .local/localnet/state*.json (refused).
# COLLARA_DEVNET_STATE=

# --- API / worker (same file) ---------------------------------------------------------------------------------
# PORT=4000
# WORKER_HEALTH_PORT=4100
# SESSION_SECRET=   (32+ random characters; required with NODE_ENV=production)
# DEMO_SESSIONS_ENABLED=true   (synthetic demo personas; demo environments only)
# Object storage for evidence documents (optional; bootstrap --profile main needs it unless --skip-documents):
# COLLARA_S3_ENDPOINT=http://127.0.0.1:8333
# COLLARA_S3_ACCESS_KEY=
# COLLARA_S3_SECRET_KEY=
# Never set CANTON_JWT_HMAC_SECRET or COLLARA_LOCALNET_STATE here: DEVNET refuses both.
