# apps/web environment. Copy to apps/web/.env.local (git-ignored); Next.js reads it from the app
# directory, not from the root .env. Variables set in the shell win. Synthetic demo data only.

# Runtime mode, read on the server at request time: UI_MOCK (default) or LOCALNET.
COLLARA_MODE=UI_MOCK

# Landing copy: off (approved pre-build/pilot copy, default) or localnet. Switch to localnet only once
# the LOCALNET demo works end to end (ADR-0001 §2.2).
# off | ui_mock (only with COLLARA_MODE=UI_MOCK) | localnet (only with COLLARA_MODE=LOCALNET)
PUBLIC_DEMO_STATUS=off

# Where the same-origin /api proxy (app/api/[...path]/route.ts) forwards requests; read per request.
API_INTERNAL_ORIGIN=http://127.0.0.1:4000

# Optional separate build output (any .next* name is git-ignored), so parallel builds do not collide.
# `next start` and test:e2e must use the same value as the build they serve.
# NEXT_DIST_DIR=.next

# --- $0 hosting (docs/devnet/deploy-free.md): API embedded in this Next server, no separate API host ---
# embedded = dispatch /api/* in-process to the Fastify app (apps/api/src/embedded.ts); unset = HTTP proxy above.
# API_MODE=embedded
# With API_MODE=embedded every apps/api variable (infra/env/devnet.env.example) is read from THIS environment,
# server-side only. Secrets (SESSION_SECRET, DEVNET_CREDENTIAL_KEY*, COLLARA_S3_SECRET_KEY, DATABASE_URL) must
# never be NEXT_PUBLIC_*; next.config.ts refuses to build when one carries the credential key.
# WORKER_MODE=on-request            # no persistent worker: bounded projection pass around requests
# ON_REQUEST_SYNC_BUDGET_MS=8000    # time budget of one pass
# ON_REQUEST_SYNC_MIN_INTERVAL_MS=3000
# STORAGE_UPLOAD_MODE=presigned     # browser PUTs evidence straight to storage (Vercel body limit 4.5 MB)
# DATABASE_POOL_MAX=2
# DEVNET_STATE_JSON=                # content of .local/devnet/state.json (no disk on Vercel)
# CRON_SECRET=                      # >= 16 chars; enables /api/cron/sync (daily on Vercel Hobby)
