// Decentralized-namespace (topology) threshold check, separate from the governance and confirmation thresholds.
//
// The decentralized party's PartyToParticipant mapping is owned by its decentralized namespace (DNS: 3 owner keys,
// threshold 2, one owner key in each member participant's vault, generated by DM onboarding). This script proposes
// a change to that mapping (confirmation threshold 2 -> 3) signed by ONE owner key (p1's) and shows it stays a
// pending proposal; then the same change signed by a SECOND owner key (p2's) and shows it becomes effective. It
// finally restores threshold 2 with two owner signatures (p1 + p3).
//   DEC_PARTY=<party> OWNER_P1=<fingerprint> OWNER_P2=<fingerprint> OWNER_P3=<fingerprint>
import com.digitalasset.canton.config.RequireTypes.PositiveInt
import com.digitalasset.canton.crypto.Fingerprint
import com.digitalasset.canton.topology.PartyId

val dec = PartyId.tryFromProtoPrimitive(sys.env("DEC_PARTY"))
val owner = Map(
  "p1" -> Fingerprint.tryFromString(sys.env("OWNER_P1")),
  "p2" -> Fingerprint.tryFromString(sys.env("OWNER_P2")),
  "p3" -> Fingerprint.tryFromString(sys.env("OWNER_P3")),
)
val sync = p1.synchronizers.list_connected().head.physicalSynchronizerId.logical

def q(s: String) = "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", " ") + "\""
def effective() = p1.topology.party_to_participant_mappings.list(sync, filterParty = dec.filterString).head
def pending() = p1.topology.party_to_participant_mappings.list(sync, proposals = true, filterParty = dec.filterString)
def report(step: String): Unit = {
  val e = effective()
  val ps = pending().map(r => s"{\"threshold\":${r.item.threshold.value},\"serial\":${r.context.serial.value},\"context\":${q(r.context.toString)}}").mkString(",")
  println(s"TIERB_JSON {\"step\":${q(step)},\"effectiveThreshold\":${e.item.threshold.value},\"effectiveSerial\":${e.context.serial.value},\"pendingProposals\":[$ps]}")
}

def proposeThreshold(by: String, threshold: Int, serial: PositiveInt): Unit = {
  val cur = effective()
  val participant = participants.remote.find(_.name == by).get
  participant.topology.party_to_participant_mappings.propose(
    dec,
    cur.item.participants.map(h => h.participantId -> h.permission),
    threshold = PositiveInt.tryCreate(threshold),
    partySigningKeys = cur.item.partySigningKeysWithThreshold,
    serial = Some(serial),
    signedBy = Seq(owner(by)),
    synchronize = None,
    store = sync,
  )
}

report("initial")
val s1 = effective().context.serial.increment
proposeThreshold("p1", 3, s1)
Thread.sleep(5000)
report("after p1 owner key signed threshold 3 (1 of 2 required owner signatures)")
proposeThreshold("p2", 3, s1)
utils.retry_until_true(effective().item.threshold.value == 3)
report("after p2 owner key signed the same change (2 of 2 required owner signatures)")
val s2 = effective().context.serial.increment
proposeThreshold("p1", 2, s2)
proposeThreshold("p3", 2, s2)
utils.retry_until_true(effective().item.threshold.value == 2)
report("restored threshold 2 (signed by p1 + p3 owner keys)")
