{
  "name": "@collara/canton",
  "version": "0.0.0",
  "private": true,
  "description": "Collara Canton adapter: typed JSON Ledger API v2 client, token provider, template ids, command helpers (server only)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:it": "vitest run --config vitest.it.config.ts",
    "gen": "openapi-typescript openapi/canton-3.5.19.yaml -o src/generated/ledger-api.d.ts",
    "fetch-openapi": "node scripts/fetch-openapi.mjs",
    "build:it-dar": "node scripts/build-it-dar.mjs"
  },
  "dependencies": {
    "jose": "catalog:",
    "openapi-fetch": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "openapi-typescript": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
